# Postgres connection string.
# Local dev (docker compose up -d): see your own .env for the actual local
# credentials (generated per machine, not committed here).
# Production: the connection string Neon gives you via the Vercel Marketplace.
DATABASE_URL=postgres://skillsight:CHANGE_ME@localhost:5433/skillsight

# Read by docker-compose.yml for the local Postgres container's password —
# must match the password embedded in DATABASE_URL above. Generate with:
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own origin. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google sign-in for users (never grants admin). Both must be set
# together, or the button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enables thumbnail uploads in the admin form. Without it, upload
# is disabled with a clear message and screenshots/lettermarks are still used.
BLOB_READ_WRITE_TOKEN=
